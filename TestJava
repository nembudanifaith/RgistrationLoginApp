name: TestJava

# Runs every time code is pushed to GitHub, and on pull requests into main
on:
  push:
    branches: [ "**" ]
  pull_request:
    branches: [ "main" ]

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - name: Get the code
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
          cache: maven

      # mvn test runs every test class: LoginTest (Part 1), MessageTest (Part 2)
      # and MessageManagerTest (Part 3)
      - name: Run all the unit tests
        run: mvn -B test
